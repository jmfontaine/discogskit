{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "just format && just lint-fix && just type-check && just test-unit || { echo 'Quality checks failed - fix issues before completing' >&2; exit 2; }"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(discogskit:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(grep:*)",
      "Bash(just dead-code)",
      "Bash(just deps-unused)",
      "Bash(just format)",
      "Bash(just format-check)",
      "Bash(just lint)",
      "Bash(just lint-fix)",
      "Bash(just skill-references)",
      "Bash(just test-cov:*)",
      "Bash(just test-integration:*)",
      "Bash(just test-unit:*)",
      "Bash(just test:*)",
      "Bash(just type-check)",
      "Bash(just verify-types)",
      "Bash(prek run:*)",
      "Bash(uv add:*)",
      "Bash(uv run --no-sync python benchmarks/ci.py:*)",
      "Bash(uv run --no-sync python benchmarks/subset.py:*)",
      "Bash(uv run deptry:*)",
      "Bash(uv run prek run:*)",
      "Bash(uv run pyproject-fmt:*)",
      "Bash(uv run pyright --ignoreexternal --verifytypes discogskit)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python benchmarks/ci.py:*)",
      "Bash(uv run python benchmarks/run.py:*)",
      "Bash(uv run python benchmarks/subset.py:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run ty:*)",
      "Bash(uv sync:*)",
      "Bash(wc:*)",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__plugin_context7_context7__resolve-library-id",
      "Read(//tmp/**)"
    ]
  }
}
